{
  "name": "cutover-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Runbook orchestration platform for M&A data-migration cutover events",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cutover/db generate",
    "db:migrate": "pnpm --filter @cutover/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
